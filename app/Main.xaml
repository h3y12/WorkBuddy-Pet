<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WorkBuddy 桌宠" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="MenuTogglePanel" Header="收起状态面板" />
                <MenuItem Header="设置…" x:Name="MenuSettings" />
                <Separator />
                <MenuItem x:Name="MenuLaunchWb" Header="启动时顺带拉起 WorkBuddy" IsCheckable="True" />
                <MenuItem x:Name="MenuTopmost" Header="总在最前" IsCheckable="True" IsChecked="True" />
                <MenuItem x:Name="MenuAutoHide" Header="自动隐藏（有新请求时自动出现）" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="隐藏到托盘" x:Name="MenuHide" />
                <MenuItem Header="退出" x:Name="MenuExit" />
            <Separator /><MenuItem Header="脚本版 0.3.2" IsEnabled="False" /><MenuItem Header="导出诊断…" x:Name="MenuExport" /></ContextMenu>
        </Grid.ContextMenu>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">

            
            <Border x:Name="Bubble" Margin="6,0,6,2" Padding="11,8,11,9" CornerRadius="13" HorizontalAlignment="Center" Background="#FDFBF9F6" BorderBrush="#1F2B2118" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.13" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="#2F6FEB" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusText" Text="连接中…" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F6FEB" VerticalAlignment="Center" />
                        <TextBlock x:Name="ExtraText" Text="" FontSize="10.5" Foreground="#8A9099" Margin="6,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="TitleText" Text="" FontSize="11" Foreground="#5B616B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />

                    
                    <Border Height="3" CornerRadius="1.5" Background="#12000000" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="UsageCol" Width="0*" />
                                <ColumnDefinition x:Name="RestCol" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="UsageFill" Grid.Column="0" RadiusX="1.5" RadiusY="1.5" Fill="#7C8B9A" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="UsageText" Text="" FontSize="10.5" Foreground="#7D838C" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            
            <Canvas x:Name="PetArea" Width="236" Height="146" Background="Transparent" HorizontalAlignment="Center">
                <Canvas.LayoutTransform>
                    <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                </Canvas.LayoutTransform>
                <Ellipse x:Name="Shadow" Width="70" Height="8" Fill="#161A1A1A" Canvas.Left="83" Canvas.Top="132" />

                <Image x:Name="Mascot" Width="129" Height="129" Canvas.Left="54" Canvas.Top="0" RenderTransformOrigin="0.5,1" IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" CenterX="64.5" CenterY="124" />
                            <TranslateTransform x:Name="BodyShift" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                
                <Grid x:Name="Badge" Width="24" Height="24" Canvas.Left="170" Canvas.Top="8" Visibility="Collapsed" IsHitTestVisible="False">
                    <Ellipse x:Name="BadgeRing" Fill="#FFFFFF" Opacity="0.92" />
                    <Ellipse x:Name="BadgeCircle" Margin="2" Fill="#1B8A53" />
                    <TextBlock x:Name="BadgeText" Text="✓" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                
                <StackPanel x:Name="Dots" Orientation="Horizontal" Canvas.Left="174" Canvas.Top="22" Visibility="Collapsed" IsHitTestVisible="False">
                    <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="#2F6FEB" Margin="0,0,3,0" />
                    <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="#2F6FEB" Margin="0,0,3,0" />
                    <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#2F6FEB" />
                </StackPanel>
            </Canvas>
        </StackPanel>
    </Grid>
</Window>
