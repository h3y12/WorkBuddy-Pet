<Window x:Class="WbPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠设置"
        Width="330"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FCFCFBF9"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <StackPanel Margin="20,16,20,16">

        <TextBlock x:Name="FontLabel" Text="字号：11（10–18）" FontSize="12.5" Foreground="#3C4149" />
        <Slider x:Name="FontSlider" Margin="0,6,0,16"
                Minimum="10" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="FontSlider_ValueChanged" />

        <TextBlock x:Name="OpacityLabel" Text="面板不透明度：95%" FontSize="12.5" Foreground="#3C4149" />
        <Slider x:Name="OpacitySlider" Margin="0,6,0,16"
                Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="OpacitySlider_ValueChanged" />

        <TextBlock x:Name="PetLabel" Text="角色大小：100%（40–100）" FontSize="12.5" Foreground="#3C4149" />
        <Slider x:Name="PetSlider" Margin="0,6,0,6"
                Minimum="40" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="PetSlider_ValueChanged" />

        <Button Content="完成" Margin="0,18,0,0" Padding="0,6" Click="Close_Click" />
    </StackPanel>
</Window>
